#! /bin/bash
__init__() {
    if [[ -z "$__OMNI" || "$__OMNI" != "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" ]]; then
        export __OMNI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    fi
    export __OMNI_MODS="$__OMNI/mods"
    export __OMNI_CONF="$__OMNI/conf"
    export __OMNI_TOOLS="$__OMNI/tools"
    export __OMNI_CONTEXTS="$__OMNI/contexts"
    [[ -d "$__OMNI_TOOLS" ]] || mkdir -p "$__OMNI_TOOLS" 2>/dev/null || true
    
    export OMNI="${OMNI:-$HOME/.omni}"
    export OMNIRC="${OMNIRC:-$OMNI/omnirc}"
    
    source "$__OMNI_MODS/helper" && __helper__
    __declare --dict ENVS ENV_VARS ENV_LAZY ENV_OPEN ENV_COMMA PROVIDERS ENV_PROVIDERS TOOLS ENV_TOOLS IMPORTS CONTEXTS ENV_TRASH
    
    mkdir -p "$OMNI" && touch "$OMNIRC" && source "$OMNIRC"
    
    declare -gA PROVIDERS_LOCAL 2>/dev/null || true
    if [[ -d "${OMNI}/tools" ]]; then
        PROVIDERS_LOCAL[omni]="${OMNI}/tools@@tools@@contexts"
    fi
    
    __load omni --from "$__OMNI_MODS/omni" --lazy && unset -f omni.__compl__
    local files
    shopt -s nullglob
    files=("$__OMNI_TOOLS"/*)
    shopt -u nullglob
    local valid_tools=()
    for f in "${files[@]}"; do
        local bname="${f##*/}"
        if [[ -f "$f/$bname" || -f "$f" ]]; then
            valid_tools+=("$bname")
        fi
    done
    local OIFS="$IFS"
    IFS=,
    export TOOLS_LIST="${valid_tools[*]}"
    IFS="$OIFS"
    export ENV="${__ENV}"
    if [[ -n "$ENV" ]]; then
        omni envs use "$ENV" --global
    fi
}
__init__
unset -f __init__
