#! /bin/bash

__omni__() {
    __OMNI_COMMANDS="doc init builtins envs tools providers contexts run ssh trash"
    declare -gA ENV_TRASH 2>/dev/null || true

    __omni__.__help__() {
        echo """ABOUT:
    the omnishell cli
USAGE:
    omni <command> [args]
COMMANDS:
    doc
    init
    builtins
    envs
    tools
    providers
    contexts
    run
    ssh
    trash
INFO:
    for custom help, try 'omni <command> --help'""" >&3
    }

    __omni__.init() {
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -c|--conf) export OMNIRC="$2"; shift ;;
                --conf=*)  export OMNIRC="${1#*=}" ;;
            esac
            shift
        done
        local rcfile="${OMNIRC:-$HOME/.omnirc}"
        export OMNIRC="$rcfile"
        if [[ ! -f "$rcfile" ]]; then
            touch "$rcfile" 2>/dev/null
        fi
        if [[ -f "$rcfile" ]]; then
            source "$rcfile"
            declare -f __log >/dev/null && __log "Sourced $rcfile" -t success -l omni
        else
            declare -f __log >/dev/null && __log "Failed to create or access $rcfile" -t error -l omni || echo "omni: Failed to create or access $rcfile" >&2
            return 1
        fi
    }

    __omni__.trash.__help__() {
        echo """ABOUT:
    omni trash manager
USAGE:
    omni trash <command> [args]
COMMANDS:
    new/set <trash> -p/--path <path> -E/--expire <days> -d/--default <true/false> [-e/--env <env>]
    clean   <trash> [-e/--env <env>]
    ls      [-e/--env <env> | -a/--all]
    rm      <trash> [-e/--env <env>] [-f/--force]""" >&2
    }

    __omni__.trash.new() {
        local t_name="" t_path="" t_expire=30 t_def="false" t_env="$ENV"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -p|--path) t_path="$2"; shift ;;
                --path=*) t_path="${1#*=}" ;;
                -E|--expire) t_expire="$2"; shift ;;
                --expire=*) t_expire="${1#*=}" ;;
                -d|--default) t_def="$2"; shift ;;
                --default=*) t_def="${1#*=}" ;;
                -e|--env) t_env="$2"; shift ;;
                --env=*) t_env="${1#*=}" ;;
                *) [[ -z "$t_name" ]] && t_name="$1" ;;
            esac
            shift
        done
        [[ -z "$t_name" || -z "$t_path" || -z "$t_env" ]] && return 1
        
        local current="${ENV_TRASH[$t_env]:-}"
        local new_val=","
        local IFS=','
        for entry in $current; do
            if [[ -n "$entry" && "${entry%%:*}" != "$t_name" ]]; then
                if [[ "$t_def" == "true" ]]; then
                    entry="${entry%:*}:false"
                fi
                new_val="${new_val}${entry},"
            fi
        done
        new_val="${new_val#,}${t_name}:${t_path}:${t_expire}:${t_def},"
        __update "ENV_TRASH" "$t_env" "$new_val" "set"
        mkdir -p "$t_path" 2>/dev/null
    }

    __omni__.trash.clean() {
        local t_name="" t_env="$ENV"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                --env=*) t_env="${1#*=}" ;;
                *) [[ -z "$t_name" ]] && t_name="$1" ;;
            esac
            shift
        done
        
        local current="${ENV_TRASH[$t_env]:-}"
        if [[ ",${current}" != *",default:"* ]]; then
            local def_path="${OMNI_TRASH:-${OMNI:-$HOME/.omni}/trash}"
            current="default:${def_path}:30:true,${current}"
        fi
        
        local IFS=','
        for entry in $current; do
            if [[ "${entry%%:*}" == "$t_name" ]]; then
                local rest="${entry#*:}"
                local p="${rest%%:*}"
                command rm -rf "$p"/*
                return 0
            fi
        done
    }

    __omni__.trash.ls() {
        local t_env="$ENV" is_all=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                --env=*) t_env="${1#*=}" ;;
                -a|--all) is_all=1 ;;
            esac
            shift
        done
        
        if (( is_all )); then
            for e in "${ENVS[@]}"; do
                local current="${ENV_TRASH[$e]:-}"
                if [[ ",${current}" != *",default:"* ]]; then
                    local def_path="${OMNI_TRASH:-${OMNI:-$HOME/.omni}/trash}"
                    local is_def="true"
                    [[ "$current" == *:true,* ]] && is_def="false"
                    current="default:${def_path}:30:${is_def},${current}"
                fi
                local IFS=','
                for entry in $current; do
                    [[ -n "$entry" ]] && echo "[$e] ${entry//:/ | }"
                done
            done
        else
            local current="${ENV_TRASH[$t_env]:-}"
            if [[ ",${current}" != *",default:"* ]]; then
                local def_path="${OMNI_TRASH:-${OMNI:-$HOME/.omni}/trash}"
                local is_def="true"
                [[ "$current" == *:true,* ]] && is_def="false"
                current="default:${def_path}:30:${is_def},${current}"
            fi
            local IFS=','
            for entry in $current; do
                [[ -n "$entry" ]] && echo "${entry//:/ | }"
            done
        fi
    }

    __omni__.trash.rm() {
        local t_name="" t_env="$ENV" force=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                --env=*) t_env="${1#*=}" ;;
                -f|--force) force=1 ;;
                *) [[ -z "$t_name" ]] && t_name="$1" ;;
            esac
            shift
        done
        
        local current="${ENV_TRASH[$t_env]:-}"
        local implicit=0
        if [[ ",${current}" != *",default:"* ]]; then
            local def_path="${OMNI_TRASH:-${OMNI:-$HOME/.omni}/trash}"
            current="${current}default:${def_path}:30:true,"
            implicit=1
        fi
        
        local new_val=","
        local IFS=','
        for entry in $current; do
            if [[ -n "$entry" && "${entry%%:*}" != "$t_name" ]]; then
                if [[ $implicit -eq 1 && "${entry%%:*}" == "default" ]]; then
                    continue
                fi
                new_val="${new_val}${entry},"
            elif [[ -n "$entry" && "${entry%%:*}" == "$t_name" ]]; then
                local rest="${entry#*:}"
                local p="${rest%%:*}"
                if [[ -d "$p" && -n "$(command ls -A "$p" 2>/dev/null)" && $force -eq 0 ]]; then
                    echo "Trash not empty. Use -f/--force or clean it." >&2
                    if [[ $implicit -eq 0 || "${entry%%:*}" != "default" ]]; then
                        new_val="${new_val}${entry},"
                    fi
                else
                    command rm -rf "$p"
                fi
            fi
        done
        __update "ENV_TRASH" "$t_env" "${new_val#,}" "set"
    }

    __omni__.trash() {
        local cmd="$1"
        [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]] && { __omni__.trash.__help__; return 0; }
        shift
        case "$cmd" in
            new|set) __omni__.trash.new "$@" ;;
            clean)   __omni__.trash.clean "$@" ;;
            ls)      __omni__.trash.ls "$@" ;;
            rm)      __omni__.trash.rm "$@" ;;
            *)       echo "omni trash: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    omni() {
        case "$1" in
            -c|--conf)
                (
                    export OMNIRC="$2"
                    unset ENV __ENV ENVS ENV_VARS ENV_LAZY ENV_OPEN ENV_COMMA PROVIDERS ENV_PROVIDERS TOOLS ENV_TOOLS IMPORTS CONTEXTS ENV_TRASH
                    declare -ga ENVS
                    declare -gA ENV_VARS ENV_LAZY ENV_OPEN ENV_COMMA PROVIDERS ENV_PROVIDERS TOOLS ENV_TOOLS IMPORTS CONTEXTS ENV_TRASH
                    [[ -f "$OMNIRC" ]] && source "$OMNIRC"
                    shift 2
                    [[ $# -eq 0 ]] && return 0
                    omni "$@"
                )
                return $?
                ;;
            --conf=*)
                (
                    export OMNIRC="${1#*=}"
                    unset ENV __ENV ENVS ENV_VARS ENV_LAZY ENV_OPEN ENV_COMMA PROVIDERS ENV_PROVIDERS TOOLS ENV_TOOLS IMPORTS CONTEXTS ENV_TRASH
                    declare -ga ENVS
                    declare -gA ENV_VARS ENV_LAZY ENV_OPEN ENV_COMMA PROVIDERS ENV_PROVIDERS TOOLS ENV_TOOLS IMPORTS CONTEXTS ENV_TRASH
                    [[ -f "$OMNIRC" ]] && source "$OMNIRC"
                    shift
                    [[ $# -eq 0 ]] && return 0
                    omni "$@"
                )
                return $?
                ;;
        esac

        local cmd="$1"
        [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]] && { __omni__.__help__; return 0; }
        shift

        case "$cmd" in
            doc)
                bash "$__OMNI/doc" --docs "$__OMNI/docs"
                ;;
            init)
                __omni__.init "$@"
                ;;
            builtins)
                declare -f __omni__.builtins >/dev/null 2>&1 || { source "$__OMNI_MODS/omni.d/builtins" && __omni.builtins__; }
                __omni__.builtins "$@"
                ;;
            envs)
                declare -f __omni__.envs >/dev/null 2>&1 || { source "$__OMNI_MODS/omni.d/envs" && __omni.envs__; }
                __omni__.envs "$@"
                ;;
            tools)
                declare -f __omni__.tools >/dev/null 2>&1 || { source "$__OMNI_MODS/omni.d/tools" && __omni.tools__; }
                __omni__.tools "$@"
                ;;
            providers)
                declare -f __omni__.providers >/dev/null 2>&1 || { source "$__OMNI_MODS/omni.d/providers" && __omni.providers__; }
                __omni__.providers "$@"
                ;;
            contexts)
                declare -f __omni__.contexts >/dev/null 2>&1 || { source "$__OMNI_MODS/omni.d/contexts" && __omni.contexts__; }
                __omni__.contexts "$@"
                ;;
            run)
                declare -f __omni__.run >/dev/null 2>&1 || { source "$__OMNI_MODS/omni.d/run" && __omni.run__; }
                __omni__.run "$@"
                ;;
            ssh)
                declare -f __omni__.ssh >/dev/null 2>&1 || { source "$__OMNI_MODS/omni.d/ssh" && __omni.ssh__; }
                __omni__.ssh "$@"
                ;;
            trash)
                __omni__.trash "$@"
                ;;
            *)
                declare -f __log >/dev/null && __log "Unknown command '$cmd' for omni" -t error -l "omni" || echo "omni: Unknown command '$cmd'" >&2
                return 1
                ;;
        esac
    }

    __omni__.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}"
        local cmd_idx=1

        if [[ "${COMP_WORDS[1]}" == "-c" || "${COMP_WORDS[1]}" == "--conf" ]]; then
            cmd_idx=3
        elif [[ "${COMP_WORDS[1]}" == "--conf="* ]]; then
            cmd_idx=2
        fi

        if [[ ${COMP_CWORD} -eq 1 ]]; then
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--conf" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "$__OMNI_COMMANDS --conf" -- "$cur") )
            fi
            return 0
        fi

        if [[ "$prev" == "-c" || "$prev" == "--conf" ]] && [[ ${COMP_CWORD} -eq 2 && $cmd_idx -eq 3 ]]; then
            compopt -o default
            return 0
        fi

        if [[ ${COMP_CWORD} -eq $cmd_idx ]]; then
            COMPREPLY=( $(compgen -W "$__OMNI_COMMANDS" -- "$cur") )
            return 0
        fi

        local cmd="${COMP_WORDS[cmd_idx]}"
        if [[ "$cmd" == "init" ]]; then
            if [[ "$prev" == "-c" || "$prev" == "--conf" ]]; then
                compopt -o default
                return 0
            fi
            COMPREPLY=( $(compgen -W "--conf" -- "$cur") )
            return 0
        fi

        if [[ "$cmd" == "trash" ]]; then
            local subcmd="${COMP_WORDS[cmd_idx+1]:-}"
            if [[ ${COMP_CWORD} -eq $((cmd_idx + 1)) ]]; then
                COMPREPLY=( $(compgen -W "new set clean ls rm" -- "$cur") )
                return 0
            fi
            if [[ ${COMP_CWORD} -eq $((cmd_idx + 2)) && "$cur" != -* && ( "$subcmd" == "clean" || "$subcmd" == "rm" || "$subcmd" == "set" || "$subcmd" == "new" ) ]]; then
                local t_env="${ENV:-}"
                local t_names="default"
                if [[ -n "${ENV_TRASH[$t_env]:-}" ]]; then
                    local IFS=','
                    for entry in ${ENV_TRASH[$t_env]}; do
                        [[ -n "$entry" && "${entry%%:*}" != "default" ]] && t_names="${t_names} ${entry%%:*}"
                    done
                fi
                COMPREPLY=( $(compgen -W "$t_names" -- "$cur") )
                return 0
            fi
            if [[ "$prev" == "-e" || "$prev" == "--env" ]]; then
                COMPREPLY=( $(compgen -W "${!ENVS[*]}" -- "$cur") )
                return 0
            fi
            if [[ "$cur" == -* ]]; then
                case "$subcmd" in
                    new|set) COMPREPLY=( $(compgen -W "-p --path -E --expire -d --default -e --env" -- "$cur") ) ;;
                    clean|rm) COMPREPLY=( $(compgen -W "-e --env -f --force" -- "$cur") ) ;;
                    ls) COMPREPLY=( $(compgen -W "-e --env -a --all" -- "$cur") ) ;;
                esac
                return 0
            fi
            return 0
        fi

        if [[ " $__OMNI_COMMANDS " == *" $cmd "* && "$cmd" != "init" ]]; then
            local __cmd__="__omni__.${cmd}"
            local __compl__="${__cmd__}.__compl__"

            if ! declare -f "${__compl__}" >/dev/null 2>&1; then
                source "$__OMNI_MODS/omni.d/$cmd" 2>/dev/null
                "__omni.${cmd}__" 2>/dev/null || true
                "${__cmd__}.__init__" 2>/dev/null || true
            fi

            if declare -f "${__compl__}" >/dev/null 2>&1; then
                local -a COMP_WORDS_BACKUP=("${COMP_WORDS[@]}")
                local COMP_CWORD_BACKUP=$COMP_CWORD
                COMP_WORDS=( "${COMP_WORDS[@]:$cmd_idx}" )
                COMP_CWORD=$((COMP_CWORD - cmd_idx))
                "${__compl__}"
                COMP_WORDS=("${COMP_WORDS_BACKUP[@]}")
                COMP_CWORD=$COMP_CWORD_BACKUP
            fi
        fi
    }

    __omni__.__init__() {
        local scripts=("$__OMNI_MODS/omni.d/*")
        local script name

        for script in ${scripts[@]}; do
            source "$script"
            name="$(basename "$script")"

            if declare -f "__omni.${name}__" > /dev/null 2>&1; then
                "__omni.${name}__" >/dev/null 2>&1
                unset -f "__omni.${name}__"
            fi
        done

        complete -o default -o bashdefault -F __omni__.__compl__ omni
    }

    __omni__.__init__
}
