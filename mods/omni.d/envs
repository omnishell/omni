#! /bin/bash

__omni.envs__() {
    __omni__.envs.__help__() {
        echo """ABOUT:
    omni environments manager

USAGE:
    omni envs <command> [args]

COMMANDS:
    ls
    set     <env> -p/--path=<path> [-b/--bin=<bin>] [-t/--tmp=<tmp>] [-s/--sec=<sec>] [-m/--mnt=<mnt>]
    get     [<env>]
    rm      <env>
    use     <env> [-g/--global] [-b/--builtins=ls,cd...]""" >&2
    }

    __global() {
        local val="$1" rcfile="${OMNIRC:-${OMNI:-$HOME/.omni}/omnirc}"
        [[ -f "$rcfile" ]] || : > "$rcfile"
        awk -v val="$val" '
            BEGIN { found = 0 }
            index($0, "__ENV=") == 1 {
                if (val != "" && !found) {
                    print "__ENV=\"" val "\""
                    found = 1
                }
                next
            }
            { print }
            END {
                if (val != "" && !found) {
                    print "__ENV=\"" val "\""
                }
            }
        ' "$rcfile" > "${rcfile}.tmp" && mv "${rcfile}.tmp" "$rcfile"
        rm -f "${OMNI:-$HOME/.omni}/.init.cache" 2>/dev/null || true
    }

    __omni__.envs.init() {
        local t_env="${1:-$ENV}"
        local env_path=""

        if [[ -n "$t_env" && -n "${ENVS[$t_env]}" ]]; then
            env_path="${ENVS[$t_env]}"
        elif [[ -n "$ENV_PATH" ]]; then
            env_path="$ENV_PATH"
        fi

        [[ -z "$env_path" ]] && return 1

        if [[ -f "$env_path/init" ]]; then
            source "$env_path/init"
        else
            return 1
        fi
    }

    __omni__.envs.ls() {
        for env in "${ENVS[@]}"; do echo "$env"; done
    }

    __omni__.envs.set() {
        local _target_name="$1"; shift
        local env_path="" bin="" tmp="" sec="" mnt=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -p=*|--path=*) env_path="${1#*=}" ;;
                -p|--path)     env_path="$2"; shift ;;
                -b=*|--bin=*)  bin="${1#*=}" ;;
                -b|--bin)      bin="$2"; shift ;;
                -t=*|--tmp=*)  tmp="${1#*=}" ;;
                -t|--tmp)      tmp="$2"; shift ;;
                -s=*|--sec=*)  sec="${1#*=}" ;;
                -s|--sec)      sec="$2"; shift ;;
                -m=*|--mnt=*)  mnt="${1#*=}" ;;
                -m|--mnt)      mnt="$2"; shift ;;
            esac
            shift
        done
        [[ -z "$_target_name" ]] && return 1

        local base_env="${OMNI:-$HOME/.omni}/envs/$_target_name"
        [[ -z "$env_path" ]] && env_path="$base_env"
        [[ -z "$bin" ]]      && bin="$base_env/bin"
        [[ -z "$tmp" ]]      && tmp="$base_env/tmp"
        [[ -z "$sec" ]]      && sec="$base_env/sec"
        [[ -z "$mnt" ]]      && mnt="$base_env/mnt"

        local rcfile="${OMNIRC:-${OMNI:-$HOME/.omni}/omnirc}"
        if ! grep -qF "ENVS+=($_target_name)" "$rcfile" 2>/dev/null; then
            echo "ENVS+=($_target_name)" >> "$rcfile"
        fi

        __update "ENV_VARS" "$_target_name" "path:$env_path,bin:$bin,tmp:$tmp,sec:$sec,mnt:$mnt" "set"
    }

    __omni__.envs.get() {
        local _target_name="${1:-$ENV}"
        [[ -z "$_target_name" ]] && return 1
        [[ -z "${ENVS[$_target_name]:-}" && "${ENVS[*]}" != *"$_target_name"* ]] && return 1
        local str=",${ENV_VARS[$_target_name]:-},"

        local e_path="${str#*,path:}"
        echo "ENV_PATH=${e_path%%,*}"
        local e_bin="${str#*,bin:}"
        echo "BIN=${e_bin%%,*}"
        local e_tmp="${str#*,tmp:}"
        echo "TMP=${e_tmp%%,*}"
        local e_sec="${str#*,sec:}"
        echo "SEC=${e_sec%%,*}"
        local e_mnt="${str#*,mnt:}"
        echo "MNT=${e_mnt%%,*}"
    }

    __omni__.envs.rm() {
        local _target_name="$1"
        [[ -z "$_target_name" ]] && return 1
        if ! __is env "$_target_name"; then return 1; fi
        [[ "${__ENV:-}" == "$_target_name" ]] && __global ""

        unset "ENVS[$_target_name]" "ENV_VARS[$_target_name]" "ENV_LAZY[$_target_name]" \
              "ENV_COMMA[$_target_name]" "ENV_OPEN[$_target_name]" "ENV_PROVIDERS[$_target_name]" \
              "ENV_TOOLS[$_target_name]" "ENV_CONTEXTS[$_target_name]" 2>/dev/null || true

        local rcfile="${OMNIRC:-${OMNI:-$HOME/.omni}/omnirc}"
        if [[ -f "$rcfile" ]]; then
            awk -v tgt="$_target_name" '
                $0 == "ENVS+=(" tgt ")" { next }
                index($0, "[\"" tgt "\"]=") > 0 { next }
                { print }
            ' "$rcfile" > "${rcfile}.tmp" && mv "${rcfile}.tmp" "$rcfile"
        fi
        rm -f "${OMNI:-$HOME/.omni}/.init.cache" 2>/dev/null || true
    }

    _omni_bind_lazy_builtins() {
        local b_list="$1" b
        local all_b="has clip cd back home ls lf ld la laf lad ln mf md rm mv cp"
        [[ -z "$b_list" ]] && b_list="$all_b" || b_list="${b_list//,/ }"
        for b in $b_list; do
            alias "$b=__omni__.builtins.cmd.$b"
            if ! declare -f "__omni__.builtins.cmd.$b" >/dev/null 2>&1; then
                eval "function __omni__.builtins.cmd.$b() {
                    source \"\$__OMNI_MODS/omni.d/builtins\" && __omni.builtins__ && unset -f __omni.builtins__
                    __omni__.builtins.cmd.$b \"\$@\"
                }"
            fi
        done
        alias -- -="back"
        alias -- --="home"
    }

    __omni__.envs.use() {
        local _target_name="$1"
        if [[ -z "$_target_name" ]]; then _target_name="$ENV"; fi
        [[ -z "$_target_name" ]] && return 1
        shift
        local set_global=false b_list=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -g|--global) set_global=true ;;
                -b=*|--builtins=*) b_list="${1#*=}" ;;
                -b|--builtins) b_list="$2"; shift ;;
            esac
            shift
        done
        if ! __is env "$_target_name"; then return 1; fi
        export ENV="$_target_name"
        local str=",${ENV_VARS[$_target_name]:-},"

        export ENV_PATH="${str#*,path:}" && export ENV_PATH="${ENV_PATH%%,*}"
        export BIN="${str#*,bin:}" && export BIN="${BIN%%,*}"
        export TMP="${str#*,tmp:}" && export TMP="${TMP%%,*}"
        export SEC="${str#*,sec:}" && export SEC="${SEC%%,*}"
        export MNT="${str#*,mnt:}" && export MNT="${MNT%%,*}"
        [[ -n "$BIN" && ":$PATH:" != *":$BIN:"* ]] && export PATH="$PATH:$BIN"

        if $set_global && [[ "${__ENV:-}" != "$_target_name" ]]; then
            __global "$_target_name"
            export __ENV="$_target_name" __ENV_PATH="$ENV_PATH"
        fi

        if declare -f __omni__.builtins.__init__ >/dev/null 2>&1; then
            if [[ -z "$b_list" ]]; then
                __omni__.builtins.__init__
            else
                for b in ${b_list//,/ }; do
                    __omni__.builtins.use "$b" -e "$_target_name"
                done
            fi
        else
            _omni_bind_lazy_builtins "$b_list"
        fi

        local active_tools="${ENV_TOOLS[$_target_name]:-}"
        if [[ -n "$active_tools" ]]; then
            local prov_dir="${OMNI:-$HOME/.omni}/providers"
            local tools_cache="${OMNI:-$HOME/.omni}/tools"
            local OIFS="$IFS"
            IFS=','
            local entries=($active_tools)
            IFS="$OIFS"
            for entry in "${entries[@]}"; do
                if [[ -n "$entry" ]]; then
                    if [[ "$entry" == "path@@"* ]]; then
                        local t_path="${entry#path@@}"
                        if [[ -d "$t_path" ]]; then
                            local t_name="${t_path##*/}"
                            __load tool "$t_name" --from "$t_path" --lazy
                        elif [[ -f "$t_path" ]]; then
                            local bname="${t_path##*/}"
                            local dname="${t_path%/*}"
                            [[ "$dname" == "$t_path" ]] && dname="."
                            local t_name="$bname"
                            [[ "$bname" == "init" ]] && t_name="${dname##*/}"
                            __load file "$bname" --from "$dname" --lazy
                            if [[ "$bname" != "$t_name" ]]; then
                                eval "function ${t_name}() { ${bname} \"\$@\"; }"
                            fi
                        fi
                    elif [[ "$entry" == "url@@"* ]]; then
                        local rest="${entry#url@@}"
                        local t_name="${rest##*@@}"
                        if [[ -d "$tools_cache/$t_name" ]]; then
                            __load tool "$t_name" --from "$tools_cache/$t_name" --lazy
                        fi
                    else
                        local p_name="builtins"
                        local t_name="$entry"
                        if [[ "$entry" == *"@@"* ]]; then
                            p_name="${entry%%@@*}"
                            t_name="${entry#*@@}"
                        fi
                        if [[ "$p_name" == "builtins" ]]; then
                            __load tool "$t_name" --from "$__OMNI_TOOLS" --lazy
                        else
                            if [[ -d "$prov_dir/$p_name/tools/$t_name" ]]; then
                                __load tool "$t_name" --from "$prov_dir/$p_name/tools/$t_name" --lazy
                            elif [[ -d "$tools_cache/$t_name" ]]; then
                                __load tool "$t_name" --from "$tools_cache/$t_name" --lazy
                            elif [[ -d "${__OMNI%/*}/$t_name" ]]; then
                                __load tool "$t_name" --from "${__OMNI%/*}/$t_name" --lazy
                            else
                                __load tool "$t_name" --from "$prov_dir/$p_name/tools" --lazy
                            fi
                        fi
                    fi
                fi
            done
        fi

        local active_contexts="${ENV_CONTEXTS[$_target_name]:-}"
        if [[ -n "$active_contexts" ]]; then
            local prov_dir="${OMNI:-$HOME/.omni}/providers"
            local OIFS="$IFS"
            IFS=','
            local entries=($active_contexts)
            IFS="$OIFS"
            for entry in "${entries[@]}"; do
                if [[ -n "$entry" ]]; then
                    local p_name="builtins"
                    local c_name="$entry"
                    if [[ "$entry" == *"@@"* ]]; then
                        p_name="${entry%%@@*}"
                        c_name="${entry#*@@}"
                    fi
                    __load context "$c_name" --from "$prov_dir/$p_name/contexts" --lazy
                fi
            done
        fi

        [[ -f "$ENV_PATH/init" ]] && source "$ENV_PATH/init"
        return 0
    }

    __omni__.envs() {
        local cmd="$1"
        [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]] && { __omni__.envs.__help__; return 0; }
        shift

        case "$cmd" in
            init) __omni__.envs.init "$@" ;;
            ls)   __omni__.envs.ls   "$@" ;;
            set)  __omni__.envs.set  "$@" ;;
            rm)   __omni__.envs.rm   "$@" ;;
            get)  __omni__.envs.get  "$@" ;;
            use)  __omni__.envs.use  "$@" ;;
            *)    return 1 ;;
        esac
    }

    __omni__.envs.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" base_cmd="${COMP_WORDS[1]:-}"
        if [[ "${COMP_CWORD}" == 1 ]]; then
            COMPREPLY=( $(compgen -W "ls get set rm use init --help -h" -- "$cur") )
            return 0
        fi
        local flags=""
        case "$base_cmd" in
            set) flags="--path --bin --tmp --sec --mnt" ;;
            use) flags="--global --builtins" ;;
        esac
        if [[ "$base_cmd" == "set" ]]; then
            COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0
        fi
        if [[ "$base_cmd" == "use" || "$base_cmd" == "rm" || "$base_cmd" == "get" || "$base_cmd" == "init" ]]; then
            COMPREPLY=( $(compgen -W "${ENVS[*]} $flags" -- "$cur") )
            return 0
        fi
    }

    __omni__.envs.__init__() {
        __compl __omni__.envs
    }
}
