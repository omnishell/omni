#! /bin/bash

__omni.tools__() {
    declare -gA ENV_TOOLS 2>/dev/null || true

    __omni__.tools.__help__() {
    echo """ABOUT:
    omni tools manager

USAGE:
    omni tools <command> [args]

COMMANDS:
    ls      [-e|--env <env>] [-p|--provider <provider>] [-a|--all]
    use     <tool> [-e|--env <env>] [-p|--provider <provider> | --path <path>]
    rm      <tool> [-e|--env <env>] [-p|--provider <provider>]""" >&2
    }
    
    __omni__.tools.ls() {
        local t_env="" t_prov="builtins" is_all=0
        local prov_dir="${OMNI:-$HOME/.omni}/providers"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                --env=*) t_env="${1#*=}" ;;
                -p|--provider) t_prov="$2"; shift ;;
                --provider=*) t_prov="${1#*=}" ;;
                -a|--all) is_all=1 ;;
            esac
            shift
        done
        
        if [[ -n "$t_env" ]]; then
            local current="${ENV_TOOLS[$t_env]:-}"
            local OIFS="$IFS"
            IFS=','
            local entries=($current)
            IFS="$OIFS"
            for entry in "${entries[@]}"; do
                if [[ -n "$entry" ]]; then
                    if (( is_all )); then
                        echo "$entry"
                    elif [[ "$entry" == "${t_prov}@@"* ]]; then
                        echo "${entry#*@@}"
                    elif [[ "$entry" != *"@@"* && "$t_prov" == "builtins" ]]; then
                        echo "$entry"
                    fi
                fi
            done
        elif (( is_all )); then
            if [[ -d "$__OMNI_TOOLS" ]]; then
                for f in "$__OMNI_TOOLS"/*; do
                    [[ -f "$f" ]] && echo "builtins: ${f##*/}"
                done
            fi
            for p in "$prov_dir"/*; do
                if [[ -d "$p/tools" ]]; then
                    local p_name="${p##*/}"
                    for f in "$p/tools"/*; do
                        local t_name="${f##*/}"
                        [[ -f "$f/$t_name" ]] && echo "$p_name: $t_name"
                    done
                fi
            done
        else
            if [[ "$t_prov" == "builtins" ]]; then
                if [[ -d "$__OMNI_TOOLS" ]]; then
                    for f in "$__OMNI_TOOLS"/*; do
                        [[ -f "$f" ]] && echo "${f##*/}"
                    done
                fi
            elif [[ -d "$prov_dir/$t_prov/tools" ]]; then
                for f in "$prov_dir/$t_prov/tools"/*; do
                    local t_name="${f##*/}"
                    [[ -f "$f/$t_name" ]] && echo "$t_name"
                done
            fi
        fi
    }

    __omni__.tools.use() {
        local t_name="" t_env="$ENV" t_prov="builtins" t_path=""
        local prov_dir="${OMNI:-$HOME/.omni}/providers"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                --env=*) t_env="${1#*=}" ;;
                -p|--provider) t_prov="$2"; shift ;;
                --provider=*) t_prov="${1#*=}" ;;
                --path) t_path="$2"; shift ;;
                --path=*) t_path="${1#*=}" ;;
                *) [[ -z "$t_name" ]] && t_name="$1" ;;
            esac
            shift
        done
        [[ -z "$t_name" ]] && { echo "error: <tool> is mandatory" >&2; return 1; }
        [[ -z "$t_env" ]] && { echo "error: no env was set" >&2; return 1; }
        
        if [[ -n "$t_path" ]]; then
            [[ ! -f "$t_path" ]] && { echo "error: tool '$t_name' not found at '$t_path'" >&2; return 1; }
        elif [[ "$t_prov" == "builtins" ]]; then
            [[ ! -f "$__OMNI_TOOLS/$t_name" ]] && { echo "error: tool '$t_name' not found in builtins" >&2; return 1; }
        else
            if [[ ! -f "$prov_dir/$t_prov/tools/$t_name/$t_name" && ! -f "$prov_dir/$t_prov/tools/$t_name" ]]; then
                echo "error: tool '$t_name' not found in provider '$t_prov'" >&2
                return 1
            fi
        fi
        
        local current="${ENV_TOOLS[$t_env]:-}"
        local target="${t_prov}@@${t_name}"
        [[ -n "$t_path" ]] && target="path@@${t_path}"
        
        if [[ ",${current}," != *",${target},"* && !( "$t_prov" == "builtins" && -z "$t_path" && ",${current}," == *",${t_name},"* ) ]]; then
            local new_val="${current%,}"
            [[ -n "$new_val" ]] && new_val="${new_val},"
            new_val="${new_val}${target},"
            __update "ENV_TOOLS" "$t_env" "$new_val" "set"
        fi
        
        if [[ "$t_env" == "${ENV:-}" ]]; then
            if [[ -n "$t_path" ]]; then
                local t_dir="${t_path%/*}"
                [[ "$t_dir" == "$t_path" ]] && t_dir="."
                __load file "${t_path##*/}" --from "$t_dir" -l
                if [[ "${t_path##*/}" != "$t_name" ]]; then
                    eval "${t_name}() { ${t_path##*/} \"\$@\"; }"
                fi
            elif [[ "$t_prov" == "builtins" ]]; then
                __load tool "$t_name" --from "$__OMNI_TOOLS" -l
            else
                __load tool "$t_name" --from "$prov_dir/$t_prov/tools" -l
            fi
        fi
    }   

    __omni__.tools.rm() {
        local t_name="" t_env="$ENV" t_prov="builtins"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                --env=*) t_env="${1#*=}" ;;
                -p|--provider) t_prov="$2"; shift ;;
                --provider=*) t_prov="${1#*=}" ;;
                *) [[ -z "$t_name" ]] && t_name="$1" ;;
            esac
            shift
        done
        [[ -z "$t_name" ]] && { echo "error: <tool> is mandatory" >&2; return 1; }
        [[ -z "$t_env" ]] && { echo "error: no env was set" >&2; return 1; }
        
        local current="${ENV_TOOLS[$t_env]:-}"
        local target="${t_prov}@@${t_name}"
        
        if [[ ",${current}," == *",${target},"* || ( "$t_prov" == "builtins" && ",${current}," == *",${t_name},"* ) ]]; then
            local new_val=","
            local OIFS="$IFS"
            IFS=','
            local entries=($current)
            IFS="$OIFS"
            
            for entry in "${entries[@]}"; do
                if [[ -n "$entry" && "$entry" != "$target" && !( "$t_prov" == "builtins" && "$entry" == "$t_name" ) ]]; then
                    new_val+="${entry},"
                fi
            done
            new_val="${new_val#,}"
            __update "ENV_TOOLS" "$t_env" "$new_val" "set"
        fi
        
        if [[ "$t_env" == "${ENV:-}" ]]; then
            __prune "$t_name" 2>/dev/null || true
            unset -f "$t_name" "${t_name}.__compl__" "${t_name}.__help__" "${t_name}.__init__" "${t_name}.__aliases__" 2>/dev/null || true
        fi
    }

    __omni__.tools.call() {
        local t_name="" t_prov="builtins"
        local args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -p|--provider) t_prov="$2"; shift ;;
                --provider=*) t_prov="${1#*=}" ;;
                *)
                    if [[ -z "$t_name" ]]; then t_name="$1"
                    else args+=("$1"); fi
                    ;;
            esac
            shift
        done
        [[ -z "$t_name" ]] && { echo "error: <tool> is mandatory" >&2; return 1; }
        
        local prov_dir="${OMNI:-$HOME/.omni}/providers"
        local tool_dir=""
        
        if [[ "$t_prov" == "builtins" ]]; then
            tool_dir="$__OMNI_TOOLS"
            [[ ! -f "$tool_dir/$t_name" ]] && { echo "error: tool '$t_name' not found in builtins" >&2; return 1; }
        else
            tool_dir="$prov_dir/$t_prov/tools/$t_name"
            [[ ! -f "$tool_dir/$t_name" ]] && { echo "error: tool '$t_name' not found in provider '$t_prov'" >&2; return 1; }
        fi
        
        __load tool "$t_name" --from "$tool_dir"
        "$t_name" "${args[@]}"
    }

    __omni__.tools() {
        local cmd="$1"
        [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]] && { __omni__.tools.__help__; return 0; }
        shift
        case "$cmd" in
            ls)   __omni__.tools.ls "$@" ;;
            use)  __omni__.tools.use "$@" ;;
            rm)   __omni__.tools.rm "$@" ;;
            call) __omni__.tools.call "$@" ;;
            *)    echo "omni tools: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }


    __omni__.tools.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" base_cmd="${COMP_WORDS[1]:-}"
        
        if [[ "${COMP_CWORD}" == 1 ]]; then 
            COMPREPLY=( $(compgen -W "ls use rm call --help -h" -- "$cur") )
            return 0
        fi
        
        if [[ "$prev" == "-e" || "$prev" == "--env" ]]; then
            COMPREPLY=( $(compgen -W "${!ENVS[*]}" -- "$cur") )
            return 0
        fi
        
        if [[ "$prev" == "-p" || "$prev" == "--provider" ]]; then
            COMPREPLY=( $(compgen -W "${!PROVIDERS_LOCAL[*]} ${!PROVIDERS_REMOTE[*]}" -- "$cur") )
            return 0
        fi
        
        local t_prov="builtins"
        for ((i=1; i<COMP_CWORD; i++)); do
            if [[ "${COMP_WORDS[i]}" == "-p" || "${COMP_WORDS[i]}" == "--provider" ]]; then
                t_prov="${COMP_WORDS[i+1]:-}"
                break
            elif [[ "${COMP_WORDS[i]}" == "--provider="* ]]; then
                t_prov="${COMP_WORDS[i]#*=}"
                break
            fi
        done
        
        _list_tools_in_dir() {
            local p="$1"
            local prov_dir="${OMNI:-$HOME/.omni}/providers"
            if [[ "$p" == "builtins" ]]; then
                if [[ -d "$__OMNI_TOOLS" ]]; then
                    for f in "$__OMNI_TOOLS"/*; do
                        [[ -f "$f" ]] && echo "${f##*/}"
                    done
                fi
            else
                local tool_dir="$prov_dir/$p/tools"
                if [[ -d "$tool_dir" ]]; then
                    for f in "$tool_dir"/*; do 
                        local t_name="${f##*/}"
                        if [[ -f "$f/$t_name" ]]; then
                            echo "$t_name"
                        elif [[ -f "$f" ]]; then
                            echo "$t_name"
                        fi
                    done
                fi
            fi
        }
        
        _list_active_tools() {
            local e="${ENV:-}" p="$1"
            local current="${ENV_TOOLS[$e]:-}"
            local OIFS="$IFS"
            IFS=','
            local entries=($current)
            IFS="$OIFS"
            for entry in "${entries[@]}"; do
                if [[ -n "$entry" ]]; then
                    if [[ "$entry" == "${p}@@"* ]]; then echo "${entry#*@@}"
                    elif [[ "$entry" != *"@@"* && "$p" == "builtins" ]]; then echo "$entry"
                    fi
                fi
            done
        }
        
        _is_flag_value() {
            [[ "$prev" == "-e" || "$prev" == "--env" || "$prev" == "-p" || "$prev" == "--provider" || "$prev" == "--path" ]]
        }
        
        if [[ "$base_cmd" == "call" ]]; then
            local t_name="" tool_idx=-1
            for ((i=2; i<=COMP_CWORD; i++)); do
                if [[ "${COMP_WORDS[i]}" == "-p" || "${COMP_WORDS[i]}" == "--provider" ]]; then i=$((i+1))
                elif [[ "${COMP_WORDS[i]}" == "--provider="* ]]; then :
                elif [[ -z "$t_name" && "${COMP_WORDS[i]}" != -* ]]; then
                    t_name="${COMP_WORDS[i]}"
                    tool_idx=$i
                    break
                fi
            done
            if [[ -n "$t_name" && $COMP_CWORD -gt $tool_idx ]]; then
                local prov_dir="${OMNI:-$HOME/.omni}/providers"
                local tool_dir=""
                if [[ "$t_prov" == "builtins" ]]; then
                    tool_dir="$__OMNI_TOOLS"
                else
                    tool_dir="$prov_dir/$t_prov/tools"
                fi
                
                if ! declare -f "${t_name}.__compl__" >/dev/null 2>&1; then
                    if [[ -f "$tool_dir/$t_name/$t_name" || -f "$tool_dir/$t_name" ]]; then
                        __load tool "$t_name" --from "$tool_dir" >/dev/null 2>&1
                    fi
                fi
                if declare -f "${t_name}.__compl__" >/dev/null 2>&1; then
                    local -a COMP_WORDS_BACKUP=("${COMP_WORDS[@]}")
                    local COMP_CWORD_BACKUP=$COMP_CWORD
                    COMP_WORDS=( "${COMP_WORDS[@]:$tool_idx}" )
                    COMP_CWORD=$((COMP_CWORD - tool_idx))
                    "${t_name}.__compl__"
                    COMP_WORDS=("${COMP_WORDS_BACKUP[@]}")
                    COMP_CWORD=$COMP_CWORD_BACKUP
                fi
                return 0
            fi
        fi
        
        case "$base_cmd" in
            ls)
                if [[ "$cur" == -* ]]; then COMPREPLY=( $(compgen -W "-e --env -p --provider -a --all" -- "$cur") ); fi ;;
            use|call)
                if [[ "$cur" == -* ]]; then COMPREPLY=( $(compgen -W "-e --env -p --provider --path" -- "$cur") )
                elif ! _is_flag_value; then COMPREPLY=( $(compgen -W "$(_list_tools_in_dir "$t_prov")" -- "$cur") ); fi ;;
            rm)
                if [[ "$cur" == -* ]]; then COMPREPLY=( $(compgen -W "-e --env -p --provider" -- "$cur") )
                elif ! _is_flag_value; then COMPREPLY=( $(compgen -W "$(_list_active_tools "$t_prov")" -- "$cur") ); fi ;;
        esac
    }

    __omni__.tools.__init__() {
        __compl __omni__.tools
    }
}
