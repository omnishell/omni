#! /bin/bash

__omni.builtins__() {
    __BUILTINS__="has clip cd back home ls lf ld la laf lad ln mf md rm mv cp"
    __declare --dict ENV_BUILTINS

    __omni__.builtins.__help__() {
        echo """ABOUT:
    omni builtin utilities manager
USAGE:
    builtins <command> [args]
COMMANDS:
    ls      [-e|--env <env>] [-a|--all]
    set     <builtin> <func> [-e|--env <env> | -g|--global]
    use     <builtin> [-e|--env <env> | -a|--all]
    rm      <builtin> [-e|--env <env> | -g|--global] [-f|--force] [-r|--recursive]
    reset   resets all builtins to defaults
INFO:
    exposes commands (ls, cd, etc.) directly to the shell.""" >&2
    }

    __omni__.builtins.ls() {
        local t_env="${ENV}" is_all=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                -a|--all) is_all=1 ;;
            esac
            shift
        done
        if (( is_all )); then
            echo "$__BUILTINS__"
        else
            local current="${ENV_BUILTINS[$t_env]:-}"
            [[ -z "$current" ]] && echo "$__BUILTINS__" || echo "${current%,}" | tr ',' '\n'
        fi
    }

    __omni__.builtins.set() {
        local name="$1" func="$2"
        shift 2
        local mode="env" t_env="$ENV"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -g|--global) mode="global" ;;
                -e|--env) t_env="$2"; shift ;;
            esac
            shift
        done

        if [[ "$mode" == "global" ]]; then
            [[ " $__BUILTINS__ " != *" $name "* ]] && __BUILTINS__+=" $name"
            eval "__omni__.builtins.cmd.$name() { $func \"\$@\"; }"
            alias "$name=__omni__.builtins.cmd.$name"
        else
            local current="${ENV_BUILTINS[$t_env]:-}"
            [[ ",$current," != *",$name,"* ]] && __update "ENV_BUILTINS" "$t_env" "${current}${name}," "set"
            eval "__omni__.builtins.cmd.$name() { $func \"\$@\"; }"
            alias "$name=__omni__.builtins.cmd.$name"
        fi
    }

    __omni__.builtins.use() {
        local name="$1" t_env="$ENV" is_all=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
                -a|--all) is_all=1 ;;
            esac
            shift
        done
        if (( is_all )); then
            for b in $__BUILTINS__; do
                alias "$b=__omni__.builtins.cmd.$b"
            done
        else
            alias "$name=__omni__.builtins.cmd.$name"
        fi
    }

    __omni__.builtins.rm() {
        local name="$1" t_env="$ENV"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--env) t_env="$2"; shift ;;
            esac
            shift
        done
        unalias "$name" 2>/dev/null
    }

    __omni__.builtins.reset() {
        for e in "${!ENV_BUILTINS[@]}"; do
            __update "ENV_BUILTINS" "$e" "" "rm"
        done
        __omni__.builtins.__init__
    }

    __omni__.builtins() {
        local cmd="$1"
        [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]] && { __omni__.builtins.__help__; return 0; }
        shift

        case "$cmd" in
            ls)    __omni__.builtins.ls "$@" ;;
            set)   __omni__.builtins.set "$@" ;;
            use)   __omni__.builtins.use "$@" ;;
            rm)    __omni__.builtins.rm "$@" ;;
            reset) __omni__.builtins.reset "$@" ;;
            *) declare -f __log >/dev/null && __log "Unknown command '$cmd' for __omni__.builtins" -t error -l "__omni__.builtins" || echo "__omni__.builtins: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    __omni__.builtins.cmd.has() {
        for i in "$@"; do ! command -v "$i" > /dev/null 2>&1 && return 1; done; return 0;
    }
    __omni__.builtins.cmd.clip() {
        if __omni__.builtins.cmd.has xclip; then xclip -selection clipboard;
        elif __omni__.builtins.cmd.has xsel; then xsel -clipboard; else return 1; fi;
    }
    __omni__.builtins.cmd.cd() {
        command pushd -- "$@" > /dev/null 2>&1;
    }
    __omni__.builtins.cmd.back() {
        command popd > /dev/null 2>&1;
    }
    __omni__.builtins.cmd.home() {
        __omni__.builtins.cmd.cd "$HOME" && __omni__.builtins.cmd.ls;
    }
    __omni__.builtins.cmd.ls() {
        command ls --group-directories-first --color=always "$@";
    }
    __omni__.builtins.cmd.la() {
        command ls --almost-all --group-directories-first --color=always "$@";
    }
    __omni__.builtins.cmd.lf() {
        local t="${1:-.}";
        (__omni__.builtins.cmd.cd "$t" || return; find . -maxdepth 1 -mindepth 1 -type f ! -name '.*' -printf '%f\0' | xargs -0r ls --group-directories-first --color=always);
    }
    __omni__.builtins.cmd.ld() {
        local t="${1:-.}";
        (__omni__.builtins.cmd.cd "$t" || return; find . -maxdepth 1 -mindepth 1 -type d ! -name '.*' -printf '%f\0' | xargs -0r ls --group-directories-first --color=always);
    }
    __omni__.builtins.cmd.laf() {
        local t="${1:-.}";
        (__omni__.builtins.cmd.cd "$t" || return; find . -maxdepth 1 -mindepth 1 -type f -printf '%f\0' | xargs -0r ls --group-directories-first --color=always);
    }
    __omni__.builtins.cmd.lad() {
        local t="${1:-.}";
        (__omni__.builtins.cmd.cd "$t" || return; find . -maxdepth 1 -mindepth 1 -type d -printf '%f\0' | xargs -0r ls --group-directories-first --color=always);
    }
    __omni__.builtins.cmd.ln() {
        command ln -sf "$@";
    }
    __omni__.builtins.cmd.md() {
        command mkdir -p "$@";
    }
    __omni__.builtins.cmd.mf() {
        for i in "$@"; do local d="${i%/*}"; [[ "$d" == "$i" ]] && d="."; [[ ! -d "$d" ]] && __omni__.builtins.cmd.md "$d"; command touch "$i"; done;
    }

    __omni__.builtins.cmd.cp() {
        local excludes=() args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--exclude) excludes+=("$2"); shift ;;
                --exclude=*) excludes+=("${1#*=}") ;;
                *) args+=("$1") ;;
            esac
            shift
        done
        if [[ ${#args[@]} -eq 0 ]]; then
            __omni__.builtins.cmd.clip
            return 0
        elif [[ ${#args[@]} -eq 1 && -f "${args[0]}" ]]; then
            cat "${args[0]}" | __omni__.builtins.cmd.clip
            return 0
        fi
        local dest="${args[-1]}"
        local d="${dest%/*}"
        [[ "$d" == "$dest" ]] && d="."
        __omni__.builtins.cmd.md "$d"
        local filtered=()
        for arg in "${args[@]:0:${#args[@]}-1}"; do
            local skip=0
            for exc in "${excludes[@]}"; do
                [[ "$arg" == $exc ]] && skip=1 && break
            done
            [[ $skip -eq 0 ]] && filtered+=("$arg")
        done
        [[ ${#filtered[@]} -eq 0 ]] && return 0
        command cp -r "${filtered[@]}" "$dest"
    }

    __omni__.builtins.cmd.mv() {
        local excludes=() args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--exclude) excludes+=("$2"); shift ;;
                --exclude=*) excludes+=("${1#*=}") ;;
                *) args+=("$1") ;;
            esac
            shift
        done
        local dest="${args[-1]}"
        local d="${dest%/*}"
        [[ "$d" == "$dest" ]] && d="."
        __omni__.builtins.cmd.md "$d"
        local filtered=()
        for arg in "${args[@]:0:${#args[@]}-1}"; do
            local skip=0
            for exc in "${excludes[@]}"; do
                [[ "$arg" == $exc ]] && skip=1 && break
            done
            [[ $skip -eq 0 ]] && filtered+=("$arg")
        done
        [[ ${#filtered[@]} -eq 0 ]] && return 0
        command mv "${filtered[@]}" "$dest"
    }

    __omni__.builtins.cmd.rm() {
        local excludes=() args=() force=0 trash_name=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--exclude) excludes+=("$2"); shift ;;
                --exclude=*) excludes+=("${1#*=}") ;;
                -t|--trash) trash_name="$2"; shift ;;
                --trash=*) trash_name="${1#*=}" ;;
                -f|--force) force=1 ;;
                *) args+=("$1") ;;
            esac
            shift
        done
        local filtered=()
        for arg in "${args[@]}"; do
            local skip=0
            for exc in "${excludes[@]}"; do
                [[ "$arg" == $exc ]] && skip=1 && break
            done
            [[ $skip -eq 0 ]] && filtered+=("$arg")
        done
        [[ ${#filtered[@]} -eq 0 ]] && return 0

        if (( force )); then
            command rm -rf "${filtered[@]}"
        else
            local t_env="${ENV:-}"
            local trash_conf="${ENV_TRASH[$t_env]:-}"
            
            if [[ ",${trash_conf}" != *",default:"* ]]; then
                local def_path="${OMNI_TRASH:-${OMNI:-$HOME/.omni}/trash}"
                local is_def="true"
                [[ "$trash_conf" == *:true,* ]] && is_def="false"
                trash_conf="default:${def_path}:30:${is_def},${trash_conf}"
            fi
            
            local t_path="${OMNI_TRASH:-${OMNI:-$HOME/.omni}/trash}"
            local t_expire=30
            if [[ -n "$trash_conf" ]]; then
                local IFS=','
                for entry in $trash_conf; do
                    [[ -z "$entry" ]] && continue
                    local n="${entry%%:*}"
                    local rest="${entry#*:}"
                    local p="${rest%%:*}"
                    rest="${rest#*:}"
                    local e="${rest%%:*}"
                    local d="${rest#*:}"
                    if [[ "$n" == "$trash_name" || ( -z "$trash_name" && "$d" == "true" ) ]]; then
                        t_path="$p"
                        t_expire="$e"
                        break
                    fi
                done
            fi
            
            __omni__.builtins.cmd.md "$t_path"
            find "$t_path" -mindepth 1 -mtime +$t_expire -delete 2>/dev/null
            for f in "${filtered[@]}"; do
                [[ ! -e "$f" ]] && continue
                local b="${f##*/}"
                local u="${b}_$(printf "%(%s)T" -1)_$RANDOM"
                command mv "$f" "$t_path/$u"
            done
        fi
    }

    declare -gA __OMNI_BUILTINS_FLAGS=(
        ["ls"]="--env --all"
        ["set"]="--env --global"
        ["use"]="--env --all"
        ["rm"]="--env --global --force --recursive"
    )

    __omni__.builtins.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" base_cmd="${COMP_WORDS[1]:-}"
        if [[ "${COMP_CWORD}" == 1 ]]; then
            COMPREPLY=( $(compgen -W "ls set use rm reset cp mv --help -h" -- "$cur") )
            return 0
        fi
        if [[ "$prev" == "--env" ]]; then
            COMPREPLY=( $(compgen -W "${!ENVS[*]}" -- "$cur") )
            return 0
        fi
        local flags="${__OMNI_BUILTINS_FLAGS[$base_cmd]:-}"
        
        if [[ "$base_cmd" == "cp" || "$base_cmd" == "mv" ]]; then
            flags="--exclude -e"
            [[ "$cur" == -* ]] && COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0
        fi

        if [[ "$base_cmd" == "rm" ]]; then
            if [[ " ${__BUILTINS__} " == *" ${COMP_WORDS[2]:-} "* ]]; then
                flags="${__OMNI_BUILTINS_FLAGS[rm]}"
            else
                flags="--exclude -e --trash -t --force -f"
                if [[ "$prev" == "-t" || "$prev" == "--trash" ]]; then
                    local t_env="${ENV:-}"
                    local t_names="default"
                    if [[ -n "${ENV_TRASH[$t_env]:-}" ]]; then
                        local IFS=','
                        for entry in ${ENV_TRASH[$t_env]}; do
                            [[ -n "$entry" && "${entry%%:*}" != "default" ]] && t_names="${t_names} ${entry%%:*}"
                        done
                    fi
                    COMPREPLY=( $(compgen -W "$t_names" -- "$cur") )
                    return 0
                fi
            fi
            [[ "$cur" == -* ]] && COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0
        fi

        if [[ "$base_cmd" == "ls" || "$base_cmd" == "set" || "$base_cmd" == "reset" ]]; then
            COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0
        fi
        if [[ "$base_cmd" == "use" ]]; then
            COMPREPLY=( $(compgen -W "$__BUILTINS__ $flags" -- "$cur") )
            return 0
        fi
    }
     
    __omni__.builtins.__init__() {
        for b in $__BUILTINS__; do
            alias "$b=__omni__.builtins.cmd.$b"
        done
        alias -- -="back"
        alias -- --="home"
    }
}
