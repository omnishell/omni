#! /bin/bash

__help__() {
    __help__.__help__() {
        echo """ABOUT:
    omni help viewer

USAGE:
    help <target> [<method>]

FLAGS:
  -h, --help    Show this help""" >&2
    }

    function help() {
        if [[ "$1" == "--help" || "$1" == "-h" ]]; then __help__.__help__; return 0; fi
        local target="$1"
        local method="$2"

        if [[ -z "$target" ]]; then
            command help
            return 0
        fi

        if [[ -n "$method" ]]; then
            target="${target}.${method}"
        fi

        if declare -f "__${target}__.__help__" >/dev/null; then
            "__${target}__.__help__"
        elif declare -f "${target}.__help__" >/dev/null; then
            "${target}.__help__"
        else
            command help "$target" 2>/dev/null || echo "No omni help available for '$target'" >&2
            return $?
        fi
    }

    __help__.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}"
        if [[ "${COMP_CWORD}" == 1 ]]; then
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--help -h" -- "$cur") )
                return 0
            fi
            local helps
            helps=$(declare -F | awk '
                $3 ~ /\.__help__$/ {
                    fn = $3
                    sub(/\.__help__$/, "", fn)
                    if (fn ~ /^__.*__$/) {
                        sub(/^__/, "", fn)
                        sub(/__$/, "", fn)
                    }
                    if (fn != "" && index(fn, ".") == 0 && !seen[fn]++) print fn
                }
            ')
            COMPREPLY=( $(compgen -W "$helps" -- "$cur") )
            return 0
        elif [[ "${COMP_CWORD}" == 2 ]]; then
            local helps
            helps=$(declare -F | awk -v tgt="$prev" '
                $3 ~ /\.__help__$/ {
                    fn = $3
                    sub(/\.__help__$/, "", fn)
                    if (index(fn, "__" tgt "__.") == 1) {
                        m = substr(fn, length(tgt) + 6)
                        if (m != "" && !seen[m]++) print m
                    } else if (index(fn, tgt ".") == 1) {
                        m = substr(fn, length(tgt) + 2)
                        if (m != "" && !seen[m]++) print m
                    }
                }
            ')
            COMPREPLY=( $(compgen -W "$helps" -- "$cur") )
            return 0
        fi
    }

    __help__.__init__() {
        __compl help
    }
}
